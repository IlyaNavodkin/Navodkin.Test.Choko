---
// The Choko wordmark - the shared brand mark (@choko/brand) plus the name.
// Using the real mark here keeps the site in lockstep with the desktop app icon.
import logoMark from '@choko/brand/logo-mark.svg?url';
import { withBase } from '../consts';

interface Props {
  href?: string;
}
const { href = withBase() } = Astro.props;
---

<a class="wordmark" href={href} aria-label="Choko home">
  <img class="mark" src={logoMark} width="28" height="28" alt="" />
  <span class="name">choko</span>
</a>
