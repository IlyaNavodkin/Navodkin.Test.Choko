{
  "name": "choko",
  "version": "0.16.0",
  "private": true,
  "description": "A git-backed desktop application for writing and running test cases.",
  "license": "MIT",
  "author": "Jim Buck",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@choko/desktop",
    "dev:web": "turbo run dev --filter=@choko/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@choko/web",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  }
}
