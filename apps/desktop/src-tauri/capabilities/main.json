{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Минимальные права главного окна Testoritto",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-get-runtime-diagnostics",
    "allow-pick-repository",
    "allow-initialize-repository",
    "allow-close-repository",
    "allow-flush-repository",
    "allow-refresh-repository",
    "allow-catalog-workspace",
    "allow-read-case",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-commit",
    "allow-git-sync",
    "allow-save-case",
    "allow-save-run-case",
    "allow-save-run-details",
    "allow-create-case",
    "allow-create-suite",
    "allow-prepare-suite-operation",
    "allow-apply-suite-operation",
    "allow-create-run",
    "allow-organize-case",
    "allow-catalog-runs",
    "allow-read-run",
    "allow-list-recent-repositories",
    "allow-open-recent-repository",
    "allow-remember-workspace",
    "allow-read-automation",
    "allow-save-automation-profile",
    "allow-save-automation-bindings",
    "allow-set-automation-trust",
    "allow-start-automation",
    "allow-discover-automation",
    "allow-poll-automation",
    "allow-cancel-automation"
  ]
}
