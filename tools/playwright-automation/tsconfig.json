{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
